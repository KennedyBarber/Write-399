{"id":2,"name":"Roy","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People1","direction":2,"pattern":1,"characterIndex":4},"list":[{"code":111,"indent":0,"parameters":[0,12,1]},{"code":101,"indent":1,"parameters":["MC_Face",1,0,2]},{"code":401,"indent":1,"parameters":["Thanks, Roy. It’s uh, good to see you. "]},{"code":401,"indent":1,"parameters":["I wish it was under better circumstances."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["You look like shit. What happened, Victor?"]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",0,0,2]},{"code":401,"indent":1,"parameters":["Right, well I came home this morning from "]},{"code":401,"indent":1,"parameters":["the... Store... and the door was unlocked. "]},{"code":401,"indent":1,"parameters":["I stepped inside and it looked like a "]},{"code":401,"indent":1,"parameters":["tornado whipped through. There were clear "]},{"code":101,"indent":1,"parameters":["MC_Face",0,0,2]},{"code":401,"indent":1,"parameters":["signs of a struggle, and Rose was gone."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["Shit, sorry Victor, that’s awful."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",2,0,2]},{"code":401,"indent":1,"parameters":["I need your help finding her Roy, I’m "]},{"code":401,"indent":1,"parameters":["sorry to have to do this. But I’ve got a "]},{"code":401,"indent":1,"parameters":["feeling I’m heading into something bigger "]},{"code":401,"indent":1,"parameters":["than I can handle alone."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["Victor-"]},{"code":101,"indent":1,"parameters":["MC_Face",2,0,2]},{"code":401,"indent":1,"parameters":["I know. I know what you’re going to say, "]},{"code":401,"indent":1,"parameters":["that after what happened, you want nothing "]},{"code":401,"indent":1,"parameters":["to do with me-"]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["No, Victor, it isn’t that I-"]},{"code":101,"indent":1,"parameters":["MC_Face",0,0,2]},{"code":401,"indent":1,"parameters":["But this is Rose we’re talking about. My "]},{"code":401,"indent":1,"parameters":["daughter. I can’t just-"]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["I can’t come with you Victor. I have a "]},{"code":401,"indent":1,"parameters":["family of my own now."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",3,0,2]},{"code":401,"indent":1,"parameters":["What?"]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["I have a family. Wife and kids. They’re "]},{"code":401,"indent":1,"parameters":["out right now, that’s the only reason I "]},{"code":401,"indent":1,"parameters":["let you in. But Victor, I... I can’t risk "]},{"code":401,"indent":1,"parameters":["getting involved in this life again, not "]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["when I have to look after them."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",0,0,2]},{"code":401,"indent":1,"parameters":["Roy, I need you. I think Vendetta might be "]},{"code":401,"indent":1,"parameters":["involved. I’ve got a bad feeling that this "]},{"code":401,"indent":1,"parameters":["whole thing might run deeper than we know."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["Then go to the police, Roy. You’re not a "]},{"code":401,"indent":1,"parameters":["detective anymore, you can’t just go "]},{"code":401,"indent":1,"parameters":["stirring things up."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",2,0,2]},{"code":401,"indent":1,"parameters":["Roy, this is Rose we’re talking about. I "]},{"code":401,"indent":1,"parameters":["can’t just leave this alone. I’m going to "]},{"code":401,"indent":1,"parameters":["do this with or without you. "]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["I’m sorry, Victor. I just can’t risk it."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["MC_Face",0,0,2]},{"code":401,"indent":1,"parameters":["Alright, well... I’d uh... Better go then, "]},{"code":401,"indent":1,"parameters":["don’t want your family to get home and see "]},{"code":401,"indent":1,"parameters":["me."]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\c[9]Roy gives Victor a nod"]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["People1",4,0,2]},{"code":401,"indent":1,"parameters":["Goodluck Victor."]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":13,"y":6}
